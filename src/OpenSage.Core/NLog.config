<?xml version="1.0" encoding="utf-8" ?>
<!--
  OBS-3 (R15 observability plan section OBS-3) — log routing contract.

  Log directory: both file targets resolve to $OPENSAGE_LOG_DIR when that environment variable
  is set and non-empty, otherwise to ${basedir} (the launcher's bin directory, i.e. the historic
  behaviour). A harness pins the run's log location by exporting OPENSAGE_LOG_DIR=<run out-dir>
  before launching; no engine code or CLI flag is involved, so nothing has to be threaded through
  Program.cs.

  Per-run truncation: deleteOldFileOnStartup="true" on both file targets. Before this, output.log
  accumulated across runs in the bin directory and every harness tool had to diff-or-reset by hand.

  Two files, on purpose:
    output.log — everything at Debug and above; the detailed trace (this is where SimHeartbeat
                 lines land; that contract is unchanged).
    errors.log — Warn/Error/Fatal only, from every logger including OpenSage.Scripting.* and
                 OpenSage.Network.*; durable, never drowned. One line of signal per line of file.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="true">

  <extensions>
    <add assembly="OpenSage.Core"/>
  </extensions>

  <targets>
    <target name="file"
            xsi:type="File"
            fileName="${environment:OPENSAGE_LOG_DIR:whenEmpty=${basedir}}/output.log"
            deleteOldFileOnStartup="true"
            keepFileOpen="true" />
    <target name="errors"
            xsi:type="File"
            fileName="${environment:OPENSAGE_LOG_DIR:whenEmpty=${basedir}}/errors.log"
            deleteOldFileOnStartup="true"
            keepFileOpen="true"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=ToString}}" />
    <target name="console" xsi:type="ColoredConsole" layout="[${time}][${level}] ${message}"/>
    <target name="internal" xsi:type="OpenSage" layout="[${time}][${level}] ${message}"/>
  </targets>

  <rules>
    <!--
      Durable Warn+ capture first, for EVERY logger, and deliberately not final: a Warn also
      continues on to whichever detailed sink the rules below pick for it. This rule is what
      un-blackholes OpenSage.Scripting.* — a Lua/drawmodule failure now leaves a Warn in
      errors.log instead of vanishing (it used to hit writeTo="" final="true" and disappear,
      which is how a whole failure class stayed invisible until it became a crash).
    -->
    <logger name="*" minlevel="Warn" writeTo="errors" />

    <!--
      Scripting stays off the console (it is per-frame chatter and would drown the wrapper log),
      but it is no longer discarded: Debug+ goes to output.log and the in-game log window.
    -->
    <logger name="OpenSage.Scripting.*" minlevel="Debug" writeTo="file,internal" final="true"/>

    <logger name="OpenSage.Network.*" minlevel="Trace" writeTo="console" final="true"/>
    <logger name="*" minlevel="Info" writeTo="console" />
    <logger name="*" minlevel="Debug" writeTo="file" />
    <logger name="*" minlevel="Trace" writeTo="internal" />
  </rules>
</nlog>
